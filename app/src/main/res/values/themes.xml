<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aerostat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Aerostat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/graphite</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aerostat</item>
    </style>
</resources>
